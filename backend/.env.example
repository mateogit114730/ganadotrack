# Copiar este archivo como .env y ajustar los valores.
# Nunca subir el archivo .env al repositorio.

# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://ganadotrack:ganadotrack@localhost:5433/ganadotrack?schema=public"

# Puerto de la API
PORT=4000

# Secreto para firmar los tokens JWT (usar una cadena larga y aleatoria)
JWT_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"

# Duración de la sesión sin actividad (RNF04: 8 horas)
JWT_EXPIRES_IN="8h"

# Origen permitido para el frontend (CORS)
CORS_ORIGIN="http://localhost:5173"

# Contraseña inicial de los usuarios de demostración creados por el seed
SEED_PASSWORD="elegir-una-contrasena-de-demo"
